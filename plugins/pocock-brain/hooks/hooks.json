{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wiki_budget.py\" \"${CLAUDE_PLUGIN_ROOT}/wiki\" pocock"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/footer_check.py\" \"${CLAUDE_PLUGIN_ROOT}/wiki\" pocock '\\b(Pocock|Matt)\\b'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run_check.py\" Pocock pocock-brain:pocock pocock-brain:do"
          }
        ]
      }
    ]
  }
}
